# ---- Server ----
PORT=3000

# Protect the API. Any request to /api/* must send this key as the
# "x-api-key" header (or "?apiKey=" query). Leave blank to disable auth
# (only do that for local testing).
API_KEY=change-me-to-a-long-random-string

# ---- Challan data provider ----
# Which source to pull challan data from.
#   mock          -> realistic demo data, no internet needed (default)
#   instantpay    -> InstantPay Vehicle Challan API (real data, paid account)
#   mastersindia  -> Masters India e-Challan API (real data, paid account)
#   http          -> generic third-party e-challan API (see below)
CHALLAN_PROVIDER=mock

# ---- InstantPay provider (CHALLAN_PROVIDER=instantpay) ----
# Get the client id/secret from your InstantPay developer dashboard.
INSTANTPAY_CLIENT_ID=your-client-id
INSTANTPAY_CLIENT_SECRET=your-client-secret
INSTANTPAY_AUTH_CODE=1
# End-customer IP sent with each request (used by InstantPay for the lookup).
INSTANTPAY_ENDPOINT_IP=127.0.0.1
INSTANTPAY_LATITUDE=0
INSTANTPAY_LONGITUDE=0
INSTANTPAY_CONSENT=Y
INSTANTPAY_URL=https://api.instantpay.in/identity/vehicleChallan

# ---- Masters India provider (CHALLAN_PROVIDER=mastersindia) ----
# Get these from your Masters India account. Subid is shared during onboarding.
MI_USERNAME=your_email@example.com
MI_PASSWORD=your_password
MI_SUBID=your-subid-from-masters-india
# These usually don't need changing:
MI_PRODUCTID=arap
MI_MODE=Buyer
MI_AUTH_URL=https://api-platform.mastersindia.co/api/v2/token-auth/
MI_CHALLAN_URL=https://api-platform.mastersindia.co/api/v2/sbt/ECHALLAN/

# Settings used only when CHALLAN_PROVIDER=http.
# Most providers (Surepass, APIClub, RapidAPI, etc.) accept the vehicle
# number and return a list of challans. Fill these in for your provider.
CHALLAN_API_URL=https://api.example.com/v1/challan
CHALLAN_API_KEY=your-provider-api-key
# How the vehicle number is sent: "body" (JSON POST) or "query" (GET ?vehicle=)
CHALLAN_API_MODE=body
# Field name the provider expects for the vehicle number.
CHALLAN_API_VEHICLE_FIELD=vehicle_number
# Auth header style: "bearer" -> Authorization: Bearer <key>,
# "x-api-key" -> x-api-key: <key>, "token" -> token: <key>
CHALLAN_API_AUTH=x-api-key

# ---- Automation ----
# How often (in hours) to automatically refresh challans for every bus.
REFRESH_INTERVAL_HOURS=12
# Refresh once immediately on startup (true/false).
REFRESH_ON_START=true
