# ---- Server ----
PORT=3000

# Protect the API. Any request to /api/* must send this key as the
# "x-api-key" header (or "?apiKey=" query). Leave blank to disable auth
# (only do that for local testing).
API_KEY=change-me-to-a-long-random-string

# ---- Challan data provider ----
# Which source to pull challan data from.
#   mock   -> generates realistic demo data, no internet needed (default)
#   http   -> calls a real third-party e-challan API (see below)
CHALLAN_PROVIDER=mock

# Settings used only when CHALLAN_PROVIDER=http.
# Most providers (Surepass, APIClub, RapidAPI, etc.) accept the vehicle
# number and return a list of challans. Fill these in for your provider.
CHALLAN_API_URL=https://api.example.com/v1/challan
CHALLAN_API_KEY=your-provider-api-key
# How the vehicle number is sent: "body" (JSON POST) or "query" (GET ?vehicle=)
CHALLAN_API_MODE=body
# Field name the provider expects for the vehicle number.
CHALLAN_API_VEHICLE_FIELD=vehicle_number
# Auth header style: "bearer" -> Authorization: Bearer <key>,
# "x-api-key" -> x-api-key: <key>, "token" -> token: <key>
CHALLAN_API_AUTH=x-api-key

# ---- Automation ----
# How often (in hours) to automatically refresh challans for every bus.
REFRESH_INTERVAL_HOURS=12
# Refresh once immediately on startup (true/false).
REFRESH_ON_START=true
